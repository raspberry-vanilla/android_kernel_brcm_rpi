/dts-v1/;
/plugin/;

/ {
	/*
	 * Depending on your Pi or SoC, you might use:
	 *   compatible = "brcm,bcm2712";
	 *   compatible = "brcm,bcm2835";
	 */
	compatible = "brcm,bcm2712";

	/*
	 * ------------------------------------------------------------------
	 *  fragment@0: Override i2c1 to use rp1_i2c1_10_11 and enable it.
	 * ------------------------------------------------------------------
	 */
	fragment@0 {
		target = <&i2c1>;
		__overlay__ {
			/*
			 * Use pins 10/11 instead of 2/3. 
			 * 'rp1_i2c1_10_11' must be defined in the base DT.
			 */
			pinctrl-0 = <&rp1_i2c1_10_11>;
			status = "okay";
		};
	};

	/*
	 * ------------------------------------------------------------------
	 *  fragment@1: GPIO pins for Goodix touchscreen (interrupt/reset)
	 * ------------------------------------------------------------------
	 */
	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			goodix_pins: goodix_pins {
				brcm,pins = <3 2>;       // interrupt, reset
				brcm,function = <0 0>;   // input
				brcm,pull = <2 2>;       // pull-up
			};
		};
	};

	/*
	 * ------------------------------------------------------------------
	 *  fragment@2: Goodix touchscreen on i2c6
	 * ------------------------------------------------------------------
	 */
	i2c_frag: fragment@2 {
		target = <&i2c6>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			gt9271: gt9271@14 {
				compatible = "goodix,gt9271";
				reg = <0x14>;
				pinctrl-names = "default";
				pinctrl-0 = <&goodix_pins>;
				interrupt-parent = <&gpio>;
				interrupts = <4 2>;   // high-to-low edge triggered
				irq-gpios = <&gpio 3 0>;
				reset-gpios = <&gpio 2 0>;
			};
		};
	};

	/*
	 * ------------------------------------------------------------------
	 *  fragment@3: DSI panel (e.g. Waveshare) at dsi1
	 * ------------------------------------------------------------------
	 */
	dsi_frag: fragment@3 {
		target = <&dsi1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			port {
				dsi_out: endpoint {
					remote-endpoint = <&panel_in>;
				};
			};

			dsi_panel: dsi_panel@0 {
				reg = <0>;
				compatible = "waveshare,10.1-dsi-touch-a,4lane";
				// panel-orientation = "left_side_up";

				port {
					panel_in: endpoint {
						remote-endpoint = <&dsi_out>;
					};
				};
			};
		};
	};

	/*
	 * ------------------------------------------------------------------
	 *  fragment@4: LSM6DS3 IMU on i2c1 at 0x6B
	 * ------------------------------------------------------------------
	 */
	fragment@4 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			/*
			 * If you prefer running i2c1 at 400 kHz, uncomment:
			 * clock-frequency = <400000>;
			 */

			lsm6ds3: lsm6ds3@6b {
				compatible = "st,lsm6ds3";
				reg = <0x6a>;
				interrupt-parent = <&gpio>;
				/*
				 * Example interrupt line on GPIO4, 
				 * active-high or active-low depends on design
				 * (adjust <4 X> as needed).
				 */
				interrupts = <4 1>;  // rising edge
				status = "okay";
			};
		};
	};

	/*
	 * ------------------------------------------------------------------
	 *  __overrides__: Merge overrides for Goodix, LSM6DS3, DSI panel
	 * ------------------------------------------------------------------
	 */
	__overrides__ {
		/* Goodix touchscreen overrides */
		addr = <&gt9271>,"reg:0",
		       <&lsm6ds3>,"reg:0";  /* so you could override LSM6DS3 addr too */
		interrupt = <&goodix_pins>,"brcm,pins:0",
		            <&gt9271>,"interrupts:0",
		            <&gt9271>,"irq-gpios:3",
		            <&lsm6ds3>,"interrupts:0";
		reset = <&goodix_pins>,"brcm,pins:2",
			<&gt9271>,"reset-gpios:2";
		i2c-path = <&i2c_frag>, "target?=0",
			   <&i2c_frag>, "target-path";

		/* DSI panel compatibility string overrides */
		4_0_inch_a         = <&dsi_panel>, "compatible=waveshare,4.0-dsi-touch-a";
		5_0_inch_a         = <&dsi_panel>, "compatible=waveshare,5.0-dsi-touch-a";
		5_5_inch_a         = <&dsi_panel>, "compatible=waveshare,5.5-dsi-touch-a";
		7_0_inch_a         = <&dsi_panel>, "compatible=waveshare,7.0-dsi-touch-a";
		7_0_inch_b         = <&dsi_panel>, "compatible=waveshare,7.0-dsi-touch-b";
		7_0_inch_c         = <&dsi_panel>, "compatible=waveshare,7.0-dsi-touch-c";
		8_0_inch_a         = <&dsi_panel>, "compatible=waveshare,8.0-dsi-touch-a";
		8_0_inch_a_4lane   = <&dsi_panel>, "compatible=waveshare,8.0-dsi-touch-a,4lane";
		8_1_inch_a         = <&dsi_panel>, "compatible=waveshare,8.1-dsi-touch-a";
		10_1_inch_a        = <&dsi_panel>, "compatible=waveshare,10.1-dsi-touch-a";
		10_1_inch_a_4lane  = <&dsi_panel>, "compatible=waveshare,10.1-dsi-touch-a,4lane";
		10_1_inch_b        = <&dsi_panel>, "compatible=waveshare,10.1-dsi-touch-b";
		10_1_inch_b_4lane  = <&dsi_panel>, "compatible=waveshare,10.1-dsi-touch-b,4lane";

		/*
		 * Optional named parameter to enable LSM6DS3.
		 * For instance: dtoverlay=productshop-devboard-v1,lsm6ds3=on
		 * might (on some overlay systems) set the node status.
		 */
		lsm6ds3 = <0>,"+0";
	};
};